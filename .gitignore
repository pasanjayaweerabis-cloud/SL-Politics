# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment — never commit secrets or connector credentials.
# The *.example templates are documentation, not secrets: they carry
# placeholders (CHANGE_ME) and no real values. `.env.*` alone matched
# .env.production.example and .env.staging.example too, so 7 KB of
# deployment documentation existed on one machine and in no clone.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and tooling output
coverage/
.vitest/
*.tsbuildinfo

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Claude Code tooling artefacts — plugin bundles and other generated output
# dropped here by the editor. Not project source; the site never reads them.
Claude outputs/

# Local database (regenerate with: npm run db:migrate && npm run sync:parliament)
.data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak
*.backup
*.dump
# NOT *.sql — server/db/migrations/*.sql is real, tracked source, and a
# blanket ignore would silently hide a future migration file from `git add`.

# design-sync (Claude Design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
# Generated concatenation of all four src stylesheets. Regenerated by the
# design-sync tool on every run; committing it creates a second copy of the
# entire stylesheet that silently drifts from the real one.
.design-sync/aggregate-styles.css
