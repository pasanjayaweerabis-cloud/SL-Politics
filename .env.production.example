# SL Politics — PRODUCTION environment.
#
# The live site. This file lists only what differs from .env.example
# (development) — see that file for what each variable means and why it
# defaults the way it does. Every `CHANGE_ME` below is a placeholder that
# MUST be replaced with a real, generated value before deploying; none of
# them are usable as written, and none of them belong in version control —
# inject them via the hosting platform's own secret storage, not by editing
# this file in place and committing it.

# ------------------------------------------------------------------- build
#
# FRONTEND URL. Every prerendered page's canonical tag, every Open Graph
# url, and every sitemap.xml entry is built from this — see prerender.mjs,
# which refuses to build at all without it (no placeholder domain is ever
# silently substituted).
VITE_SITE_ORIGIN=https://javora.lk

# ---------------------------------------------------------------- database
#
# JAVORA_DB — the canonical write path. This is what the sync worker
# actually writes to, on every run, regardless of whether DATABASE_URL below
# is set. Put it on a volume that survives a redeploy: a fresh, empty file
# here is indistinguishable from "the entire synchronised history was lost."
JAVORA_DB=/var/lib/javora/production/javora.db

# DATABASE_URL — PostgreSQL, accelerating five read endpoints only (health,
# people, a single person, search, facets) via a real connection pool. Does
# NOT replace JAVORA_DB above; see .env.example for exactly which endpoints
# this does and does not affect, and why. Omit this line entirely to run
# production on SQLite alone — every endpoint still works, just without
# Postgres's connection pooling under concurrent read load.
#
# THE CREDENTIAL HERE MUST BE READ-ONLY. The API only ever issues SELECT —
# server/api/server.ts's own SQLite connection is opened with SQLite's
# read-only mode for exactly this reason (see openDatabase's `readOnly`
# option) — but Postgres has no equivalent "this whole connection string is
# read-only" flag; the restriction has to be provisioned at the database
# level. `node scripts/provision-postgres-roles.mjs` (run once, with an
# ADMIN connection string, per its own header comment) creates exactly this
# role — SELECT-only, matching SECURITY--SL Politics.md §3.2 — plus a
# separate javora_migrate role for scripts/migrate-to-postgres.mjs to write
# through, so the two are never the same credential.
#
# THIS IS ENFORCED, NOT ONLY DOCUMENTED: server/api/server.ts calls
# assertReadOnlyPostgresCredential() at startup, which asks Postgres itself
# whether the connected role could write to `person`, and REFUSES TO START
# if it can (logging an `insecure-db-credential` error) unless
# JAVORA_ALLOW_WRITE_CAPABLE_DB=true is also set — a deliberate escape hatch
# for a deployment mid-migration to the dedicated role, not a normal
# production setting.
DATABASE_URL=postgres://javora_api:CHANGE_ME@prod-db.internal:5432/javora

# ---------------------------------------------------------------------- api
#
# API URL is what the frontend calls (below, as VITE_API_URL) and what CORS
# origins reference back — the two must name each other correctly or the
# browser blocks every request with no server-side symptom at all.
JAVORA_API_PORT=4000

# CORS ORIGINS — the production frontend, and nothing else. No wildcard: the
# API echoes an origin back only when it exactly matches an entry here.
JAVORA_CORS_ORIGINS=https://javora.lk,https://www.javora.lk

# JAVORA_TRUSTED_PROXIES — OFF by default, on purpose. A comma-separated list
# of CIDR ranges/addresses (e.g. "127.0.0.1/32,10.0.0.0/8") whose immediate
# TCP connection to this process is trusted to have set X-Forwarded-For
# honestly. Only add an entry here once deploy/nginx-api.conf (or an
# equivalent) is REALLY in front of this API and OVERWRITES X-Forwarded-For
# with `proxy_set_header X-Forwarded-For $remote_addr;` rather than appending
# to it — an "append" proxy in front of an API that also trusts the header
# lets a client prepend its own forged entries ahead of the proxy's real one.
# Left unset (the default), X-Forwarded-For is never trusted and every
# request is rate-limited by its actual socket address — safe with no proxy
# in front at all, at the cost of one shared bucket per NAT/proxy hop that
# does exist upstream of this process.
JAVORA_TRUSTED_PROXIES=

API_QUERY_TIMEOUT_MS=8000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
# Hard cap on the in-memory rate-limit bucket map (server/api/server.ts).
# The default is generous for a single-instance deployment; lower it only if
# memory is unusually constrained.
API_RATE_BUCKET_CAP=50000

# ------------------------------------------------------------- corrections
#
# POST /api/corrections is the ONE endpoint that writes (server/api/
# corrections.ts, designed in docs/corrections-security-design.md). It appends
# a row to `correction_report` with review_status='open' and can reach no
# other table; publishing an approved correction stays a separate, human
# triggered action.
#
# Left empty, the endpoint is ON. Set JAVORA_CORRECTIONS=off to disable it: it
# then answers 503 and the form says plainly that submissions are not
# connected, which is the honest answer and better than accepting reports that
# would not be stored.
JAVORA_CORRECTIONS=

# MUST SET, like JAVORA_DB above. Salts `correction_report.submitter_ip_hash`,
# the per-reporter token a moderator uses to spot "twelve reports from one
# network this hour". Generate with `openssl rand -hex 32`.
#
# Unset, server/api/corrections.ts falls back to a fresh randomUUID() PER
# PROCESS — so the hash changes on every restart and the signal silently stops
# comparing across one. Nothing fails loudly; the moderator's abuse signal just
# quietly stops working, which is the whole reason migration
# 004_correction_intake.sql added the column. Never reuse this value as a
# secret for anything else, and do not share it with staging.
JAVORA_CORRECTION_HASH_SALT=CHANGE_ME

# The rate limits are deliberately far tighter than the read API's, and on
# their own hour-long window. A real reporter files one correction at a time,
# by hand, occasionally. The GLOBAL ceiling is the one that matters most: a
# per-IP limit alone is defeated by spreading submissions across a pool of
# addresses, and the failure mode this feature actually has to survive is not
# a corrupted database — it is a queue flooded past the point where a human
# can review it carefully.
API_CORRECTION_RATE_LIMIT_WINDOW_MS=3600000
API_CORRECTION_RATE_LIMIT_MAX=5
API_CORRECTION_GLOBAL_RATE_LIMIT_MAX=200
# Body cap, enforced while reading, before JSON.parse. Keep in step with
# deploy/nginx-api.conf's client_max_body_size.
API_CORRECTION_MAX_BODY_BYTES=8192

# ----------------------------------------------------------------- frontend
#
# API URL — the production API, on its own origin. Building the frontend
# with this unset serves the bundled dataset instead of live data; that is
# a valid, working choice, not a fallback to something broken, but a
# production deployment that wants live data must set it.
VITE_API_URL=https://api.javora.lk

# ---------------------------------------------------------------- scheduler
#
# SOURCE CONFIGURATION. The two implemented connectors, enabled at their
# recommended cadence (server/scheduler/schedule.ts explains the reasoning
# for each interval) — this is the line that actually turns "automatic
# synchronisation" on. Every other source stays at 0: no connector exists
# for them, so a positive interval would be inert, not merely unwise.
PARLIAMENT_SYNC_INTERVAL=360
PARLIAMENT_REQUEST_DELAY_MS=500
PARLIAMENT_SYNC_PROFILES=false

CABINET_SYNC_INTERVAL=180
CABINET_REQUEST_DELAY_MS=1000

SYNC_FETCH_TIMEOUT_MS=30000
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_BACKOFF_MS=2000
SYNC_MAX_RUN_MINUTES=30

# -------------------------------------------------------------- logging
#
# No variable to set. Production logs are the same structured JSON lines to
# stdout/stderr as every other environment (see .env.example) — captured by
# whatever the deployment already runs (a systemd journal, `docker logs`, or
# the hosting platform's own log capture). Nothing here writes to a file
# path, so there is nothing to configure or to accidentally leave unwritable.
