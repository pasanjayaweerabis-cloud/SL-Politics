# SL Politics — STAGING environment.
#
# A real deployment (real domain, real TLS, the actual worker running) but
# pointed at data nobody depends on. Its purpose is to prove a release works
# before it reaches production — including that automatic synchronisation
# itself behaves correctly against the real Parliament and Cabinet Office
# sites, which local development cannot exercise safely on a schedule.
#
# This file lists only what differs from .env.example (development). Every
# variable not repeated here keeps its documented development default — see
# .env.example for what each one means and why.

# ------------------------------------------------------------------- build
VITE_SITE_ORIGIN=https://staging.javora.lk

# ---------------------------------------------------------------- database
#
# JAVORA_DB is the database that actually matters here: it is the ONLY thing
# the sync worker and the API's /api/status, /api/sources and
# /api/government/current write to and read from — DATABASE_URL below
# accelerates five read endpoints and nothing else (see .env.example's long
# comment on this; it is not repeated here). A staging deployment that sets
# only DATABASE_URL and forgets this path is running its worker against
# whatever JAVORA_DB defaults to, silently — set it explicitly.
JAVORA_DB=/var/lib/javora/staging/javora.db

# A SEPARATE database from production, always. Staging exists to be broken,
# reset and re-migrated without consequence — the moment it shares a database
# with production, it stops being staging and becomes a second production
# writer with no such intention. Applies to BOTH databases above.
DATABASE_URL=postgres://javora_staging:CHANGE_ME@staging-db.internal:5432/javora_staging

# ---------------------------------------------------------------------- api
JAVORA_API_PORT=4000
JAVORA_CORS_ORIGINS=https://staging.javora.lk
# A reverse proxy fronts the API in every real deployment; see deploy/. Off by
# default like production — see .env.production.example's comment on
# JAVORA_TRUSTED_PROXIES for why, and set it to this proxy's own address/CIDR
# once deploy/nginx-api.conf (or an equivalent that overwrites, not appends
# to, X-Forwarded-For) is actually in front of staging.
JAVORA_TRUSTED_PROXIES=

# ------------------------------------------------------------- corrections
#
# POST /api/corrections, the one write endpoint. See .env.example for what it
# does and .env.production.example for why each limit is set where it is; the
# reasoning is not repeated here.
#
# Empty = on. Staging is the right place to exercise this endpoint for real,
# since it is the only way to find out whether the form, CORS and the reverse
# proxy's client_max_body_size actually agree before production does it.
JAVORA_CORRECTIONS=

# Set it, and NOT to production's value. A SEPARATE salt from production, for
# the same reason the databases above are separate: sharing it would make
# staging's reporter hashes collide with production's, so a moderator
# comparing "same network?" across the two would be reading a manufactured
# match. Generate with `openssl rand -hex 32`. Unset, a fresh salt is
# generated per process and the signal stops comparing across a restart.
JAVORA_CORRECTION_HASH_SALT=CHANGE_ME

# Production's limits, deliberately — a staging run that never hits the
# ceiling proves nothing about the ceiling.
API_CORRECTION_RATE_LIMIT_WINDOW_MS=3600000
API_CORRECTION_RATE_LIMIT_MAX=5
API_CORRECTION_GLOBAL_RATE_LIMIT_MAX=200
API_CORRECTION_MAX_BODY_BYTES=8192

# ----------------------------------------------------------------- frontend
VITE_API_URL=https://api-staging.javora.lk

# ---------------------------------------------------------------- scheduler
#
# ON, and at the same cadence as production. The entire point of staging is
# to prove the worker's real behaviour against the real sources before that
# behaviour reaches production — running it against a toy schedule would
# leave exactly the gap staging exists to close. Safe here specifically
# because JAVORA_DB and DATABASE_URL above are staging's own, not production's.
PARLIAMENT_SYNC_INTERVAL=360
PARLIAMENT_REQUEST_DELAY_MS=500
CABINET_SYNC_INTERVAL=180
CABINET_REQUEST_DELAY_MS=1000
